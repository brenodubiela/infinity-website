# Copie para .env.local e preencha. Nunca versione valores reais.

# Webhook do n8n que recebe o formulário de contato e cria o lead no Kommo CRM.
# Lido só no servidor (src/app/api/contato/route.js). Sem NEXT_PUBLIC_.
N8N_WEBHOOK_URL=

# Segredo enviado no cabeçalho X-Webhook-Secret (configure Header Auth no nó Webhook do n8n).
# Na Vercel, cadastre as duas variáveis só no ambiente Production, para previews não criarem leads reais.
N8N_WEBHOOK_SECRET=

# URL pública final do site (usada no deploy da Vercel).
NEXT_PUBLIC_SITE_URL=https://www.infinity.eng.br
